# Jira Data Center (https://jira.trimble.tools)
# Create a token: Profile → Personal Access Tokens
JIRA_BASE_URL=https://jira.trimble.tools
JIRA_PAT=
JIRA_SSL_VERIFY=false

# Google Sheets — service account JSON (sheet must be shared with the SA email)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
# Optional fallback if the service-account file is missing
# GOOGLE_OAUTH_CLIENT_FILE=C:\Users\nvicqto\Downloads\client_secret_1050484904732-cg58qjslp2663qoe1v858lrlj9cd8kvi.apps.googleusercontent.com.json
# GOOGLE_TOKEN_FILE=credentials/google_token.json

GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1qrOqHYklb0hYD-xoIXj7P9gNnA7wsuo2jnaQhmJaFCU/edit?gid=0#gid=0
SPREADSHEET_ID=1qrOqHYklb0hYD-xoIXj7P9gNnA7wsuo2jnaQhmJaFCU
SHEET_TAB=capacity
NAME_COLUMN=D
CAPACITY_COLUMN=R

# Optional: skip live Google and read an exported Capacity tab instead
# CAPACITY_CSV=capacity.csv

BOARD_NAME=GSIS - Scrum Board
FIX_VERSION=2026.05.V1.0
STORY_POINTS_FIELD=customfield_10102

# Nightly IN Verification → Confluence page
CONFLUENCE_BASE_URL=https://confluence.trimble.tools
# Optional; defaults to JIRA_PAT if unset
# CONFLUENCE_PAT=
CONFLUENCE_PAGE_ID=1261831310
CONFLUENCE_PAGE_TITLE=Tickets blocked by stakeholder
IN_VERIFICATION_STATUS=IN Verification

# Weekday Blocker status → Confluence page "Tickets in 'Blocked' state"
# Status name on GSIS - Scrum Board is Blocker (board column Blocker).
BLOCKED_STATUS=Blocker
BLOCKED_CONFLUENCE_PAGE_ID=1303283178
BLOCKED_CONFLUENCE_PAGE_TITLE=Tickets in 'Blocked' state
